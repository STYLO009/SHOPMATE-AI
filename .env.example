# ============================================================================
# SHOPMATE AI — environment template
# Copy to `.env` (backend reads `backend/.env`, compose reads the root `.env`).
# Never commit real secrets.
# ============================================================================

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Database (PostgreSQL in Docker/prod, SQLite for quick local dev) -------
POSTGRES_DB=shopmate
POSTGRES_USER=shopmate
POSTGRES_PASSWORD=shopmate
DATABASE_URL=sqlite:///./shopmate.db
# DATABASE_URL=postgresql+psycopg://shopmate:shopmate@localhost:5432/shopmate

# --- Redis (optional; empty disables caching + uses in-memory rate limit) ---
REDIS_URL=

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Google OAuth 2.0 (authorization-code flow; endpoints return 503 if empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- LLM abstraction --------------------------------------------------------
# auto | ollama | huggingface | none
# auto = try Ollama -> HuggingFace -> deterministic rule-based fallback
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
HF_TOKEN=
HF_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
HF_API_URL=https://api-inference.huggingface.co/models
LLM_TIMEOUT_SECONDS=60

# --- Product data providers -------------------------------------------------
# Leave empty to use only the clearly-labelled sample dataset.
# The merchant provider reports `not_configured` instead of faking data.
MERCHANT_API_URL=
MERCHANT_API_KEY=
# Flipkart Affiliate API (affiliate.flipkart.com)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
# Amazon Creators API / Associates (Amazon.in)
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=www.amazon.in
PROVIDER_TIMEOUT_SECONDS=10

# --- Email (optional; password reset never enumerates accounts) -------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@shopmate.ai

# --- Ranking weights (must sum to 1.0; category overrides live in code) -----
WEIGHT_SPEC=0.35
WEIGHT_BUDGET=0.25
WEIGHT_PREFERENCE=0.20
WEIGHT_REVIEW=0.20

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend (frontend/.env.local) ----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
