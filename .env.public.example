# Copy to .env on the deployment host. Never commit the filled-in file.
PUBLIC_DOMAIN=shop.example.com
PUBLIC_BASE_URL=https://shop.example.com
CORS_ORIGINS=https://shop.example.com

# Use a long random secret (for example: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=replace-with-a-long-random-secret

POSTGRES_DB=shopmate
POSTGRES_USER=shopmate
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
DATABASE_URL=postgresql+psycopg://shopmate:replace-with-a-strong-url-safe-password@postgres:5432/shopmate

# Optional affiliate providers; without these, the public Deals page remains empty.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=www.amazon.in

# Optional sign-in provider; register this exact callback if Google OAuth is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shop.example.com/api/auth/google/callback

# Keep deterministic local ranking unless you configure another model provider.
LLM_PROVIDER=none
